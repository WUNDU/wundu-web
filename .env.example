BACKEND_API_BASE_URL=https://backend.wundu.tech/...
# BACKEND_API_BASE_URL=https://backend.test.wundu.tech/... (test)
# BACKEND_API_BASE_URL=http://localhost:8080/api/v1 (local)

# Google OAuth (NextAuth) — autenticação Google na web
# Credenciais OAuth do Google Cloud Console (mesmo Client ID configurado no backend)
NEXT_AUTH_GOOGLE_CLIENT_ID=
NEXT_AUTH_GOOGLE_CLIENT_SECRET=
# URL pública da app (ex.: http://localhost:3000 em dev)
NEXTAUTH_URL=http://localhost:3000
# Segredo para assinar a sessão NextAuth: gerar com `openssl rand -base64 32`
NEXTAUTH_SECRET=
